{
  "manifest_version": 3,
  "name": "Sookit — YouTube 视频嗅探",
  "version": "1.0.0",
  "description": "在 YouTube 视频页点击 Sookit，交给桌面应用在后台嗅探。",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icons/sookit-48.png",
    "128": "icons/sookit-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/sookit-48.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
